#!/usr/bin/env sh
#
# Keep commits lightweight. Builds, typechecking, Clippy and test suites are
# explicit checks in scripts/check-full.sh and CI, never automatic commit work.
#
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Include deletions so removed catalogs and Rust files still trigger checks.
staged="$(git diff --cached --name-only --diff-filter=ACMRD)"
[ -z "$staged" ] && exit 0

fail() {
  printf '\n\033[31m✗ pre-commit: %s failed.\033[0m Fix it, or bypass with: git commit --no-verify\n' "$1" >&2
  exit 1
}

git diff --cached --check || fail "staged diff"

if printf '%s\n' "$staged" | grep -qE '^((src/|packages/|web/).*\.tsx?$|biome\.json$|\.biome/)'; then
  echo "→ frontend: lint staged files"
  pnpm exec biome lint --staged --vcs-enabled=true --vcs-client-kind=git --no-errors-on-unmatched || fail "biome lint"
fi

if printf '%s\n' "$staged" | grep -qE '^(src/i18n/|packages/i18n-contract/|scripts/i18n/)'; then
  echo "→ frontend: i18n types + English / Simplified Chinese catalogs"
  pnpm i18n:types:check || fail "i18n types"
  pnpm i18n:validate --locale zh-Hans || fail "i18n validate"
fi

# Rust gate: any workspace crate or workspace configuration.
if printf '%s\n' "$staged" | grep -qE '^(src-tauri/|crates/|Cargo\.(toml|lock)$|\.cargo/|rust-toolchain\.toml$)'; then
  echo "→ rust: fmt check"
  cargo fmt --all -- --check || fail "cargo fmt"
fi

printf '\033[32m✓ lightweight pre-commit checks passed\033[0m\n'
