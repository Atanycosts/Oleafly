index 0000000..5c5c13d
--- /dev/null
+++ b/packages/core/src/layout/__tests__/equation-math-script.test.ts
@@ -0,0 +1,129 @@
+import { describe, expect, test } from 'bun:test';
+import {
+  readOoxmlPart,
+  serializeOoxmlPart,
+  canonicalOoxmlFingerprint,
+  projectOmmlEquation,
+  type OoxmlGenericElementNode,
+} from '@docx-editor.dev/core/store';
+import { layoutEquation, type EquationGeometry } from '../equation-layout.ts';
+import { resolveRunStyle } from '../run-style.ts';
+import { createFixedMeasurer } from '../fixed-measurer.ts';
+import { equationMathScriptText } from '../equation-math-alphabet.ts';
+
+const w = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
+const m = 'http://schemas.openxmlformats.org/officeDocument/2006/math';
+const run = (text: string, properties = '') => `<m:r>${properties}<m:t>${text}</m:t></m:r>`;
+
+function project(body: string) {
+  const read = readOoxmlPart(`<m:oMath xmlns:w="${w}" xmlns:m="${m}">${body}</m:oMath>`, {
+    name: '/word/document.xml',
+    contentType: 'app/xml',
+  });
+  if (!read.ok) throw new Error(read.reason);
+  return {
+    part: read.part,
+    projection: projectOmmlEquation(read.part.root as OoxmlGenericElementNode),
+  };
+}
+
+function texts(node: EquationGeometry): string[] {
+  if (node.kind === 'text' || node.kind === 'fallback') return [node.text];
+  if (node.kind === 'row') return node.items.flatMap(texts);
+  if (node.kind === 'script')
+    return [node.base, node.subscript, node.superscript].flatMap((n) => (n ? texts(n) : []));
+  if (node.kind === 'bar') return texts(node.body);
+  throw new Error('Unexpected test geometry');
+}
+
+describe('OMML mathematical scripts', () => {
+  test.each([
+    ['', 'RQ', '𝑅𝑄', 'roman italic default'],
+    [' m:val="script"', 'RQ', 'ℛ𝒬', 'script'],
+    [' m:val="script"', 'BFeHL', 'ℬℱℯℋℒ', 'script'],
+    [' m:val="fraktur"', 'CHIRZ', 'ℭℌℑℜℨ', 'fraktur'],
+    [' m:val="double-struck"', 'RCHNZld', 'ℝℂℍℕℤ𝕝𝕕', 'double-struck'],
+    [' m:val="sans-serif"/><m:sty m:val="p"', 'A', '𝖠', 'sans-serif plain'],
+    [' m:val="sans-serif"/><m:sty m:val="b"', 'A', '𝗔', 'sans-serif bold'],
+    [' m:val="script"/><m:sty m:val="b"', 'ABfz', '𝓐𝓑𝓯𝔃', 'bold script'],
+    [' m:val="sans-serif"/><m:sty m:val="i"', 'AT', '𝘈𝘛', 'sans-serif italic'],
+    [' m:val="sans-serif"/><m:sty m:val="bi"', 'ATα∂', '𝘼𝙏𝞪𝟃', 'sans-serif bold italic'],
+    [' m:val="double-struck"', '09defg', '𝟘𝟡𝕕𝕖𝕗𝕘', 'double-struck digits'],
+    [' m:val="monospace"', 'a1', '𝚊𝟷', 'monospace'],
+  ] as const)(
+    'maps script %s text to the mathematical alphabet (%s)',
+    (attribute, source, expected, label) => {
+      void label;
+      const { part, projection } = project(
+        run(source, `<m:rPr><m:scr${attribute}/></m:rPr>`)
+      );
+      const before = canonicalOoxmlFingerprint(part);
+      const result = layoutEquation(projection, createFixedMeasurer(), resolveRunStyle([]));
+      expect(texts(result.geometry)).toEqual([expected]);
+      expect(result.geometry.kind === 'text' ? result.geometry.runStyle?.bold : undefined).toBe(
+        false
+      );
+      expect(result.geometry.kind === 'text' ? result.geometry.runStyle?.italic : undefined).toBe(
+        false
+      );
+      expect(serializeOoxmlPart(part)).toContain(`<m:t>${source}</m:t>`);
+      expect(canonicalOoxmlFingerprint(part)).toBe(before);
+    }
+  );
+
+  test('does not substitute bold double-struck with a different mathematical alphabet', () => {
+    const { projection } = project(
+      run('A', '<m:rPr><m:scr m:val="double-struck"/><m:sty m:val="b"/></m:rPr>')
+    );
+    const result = layoutEquation(projection, createFixedMeasurer(), resolveRunStyle([]));
+    expect(result.geometry.kind).toBe('fallback');
+    if (result.geometry.kind !== 'fallback') throw new Error('Expected fallback');
+    expect(result.geometry.text).toBe('A');
+  });
+
+  test('combines script with m:sty without changing the source', () => {
+    const { part, projection } = project(
+      run('AB1', '<m:rPr><m:scr m:val="sans-serif"/><m:sty m:val="b"/></m:rPr>')
+    );
+    const result = layoutEquation(projection, createFixedMeasurer(), resolveRunStyle([]));
+    expect(texts(result.geometry)).toEqual(['𝗔𝗕𝟭']);
+    expect(serializeOoxmlPart(part)).toContain('<m:t>AB1</m:t>');
+    expect(canonicalOoxmlFingerprint(part)).toContain('AB1');
+  });
+
+  test('an unsupported script keeps unrepresented characters in their source form', () => {
+    const { projection } = project(
+      run('Z9甲', '<m:rPr><m:scr m:val="double-struck"/></m:rPr>')
+    );
+    expect(texts(layoutEquation(projection, createFixedMeasurer(), resolveRunStyle([])).geometry)).toEqual(['ℤ𝟡甲']);
+  });
+
+  test('rejects unknown m:scr values as unsupported OMML properties', () => {
+    const { projection } = project(run('A', '<m:rPr><m:scr m:val="chancery"/></m:rPr>'));
+    expect(projection.expression.kind).toBe('fallback');
+    if (projection.expression.kind !== 'fallback') throw new Error('Expected fallback');
+    expect(projection.expression.reason).toBe('unsupported-omml-property');
+  });
+
+  test('maps without the projection boundary when only display text changes', () => {
+    expect(
+      equationMathScriptText({
+        value: 'Rl',
+        format: { mathScript: 'script', mathStyle: 'i' },
+      })
+    ).toEqual({ text: 'ℛ𝓁', mathScript: 'script' });
+    expect(
+      equationMathScriptText({ value: 'R', format: { mathScript: 'roman' } })
+    ).toEqual({ text: 'R', mathScript: null });
+  });
+
+  test('normal text overrides the mathematical alphabet inside a structured formula', () => {
+    const { projection } = project(
+      `<m:f><m:num>${run('Text1', '<m:rPr><m:scr m:val="script"/><m:nor/></m:rPr>')}</m:num><m:den>${run('x')}</m:den></m:f>`
+    );
+    const result = layoutEquation(projection, createFixedMeasurer(), resolveRunStyle([]));
+    expect(result.geometry.kind).toBe('fraction');
+    if (result.geometry.kind !== 'fraction') throw new Error('Expected fraction');
+    expect(texts(result.geometry.numerator)).toEqual(['Text1']);
+  });
+});
