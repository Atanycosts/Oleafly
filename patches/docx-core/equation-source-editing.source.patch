+test('keeps a delimiter at its glyph height when growth is off', () => {
+  const content =
+    '<m:d><m:dPr><m:begChr m:val="{"/><m:endChr m:val=""/><m:grow m:val="0"/>' +
+    `</m:dPr><m:e>${matrix}</m:e></m:d>`;
+  const node = find(layout(content).geometry, 'delimiter');
+  if (node?.kind !== 'delimiter') throw new Error('No delimiter');
+  const sign = node.items[0]!;
+  if (sign.kind !== 'text') throw new Error('No delimiter sign');
+  expect(sign.text).toBe('{');
+  expect(sign.stretchY).toBeUndefined();
+  expect(sign.box.height).toBeLessThan(node.items[1]!.box.height);
+});
+
+test('aligns Pandoc equation-array rows around the source ampersand', () => {
+  const content =
+    '<m:eqArr>' +
+    `<m:e>${run('x')}${run('&amp;')}${run('=')}${run('1')}</m:e>` +
+    `<m:e>${run('verylong')}${run('&amp;')}${run('=')}${run('2')}</m:e>` +
+    '</m:eqArr>';
+  const node = find(layout(content).geometry, 'matrix');
+  if (node?.kind !== 'matrix') throw new Error('No equation array');
+  const [first, second] = node.rows;
+  expect(first![0]!.box.x + first![0]!.box.width).toBeCloseTo(
+    second![0]!.box.x + second![0]!.box.width,
+    6
+  );
+  expect(first![1]!.box.x).toBe(second![1]!.box.x);
+});
+
+test('uses equation-array base justification for the matrix baseline', () => {
+  const equationArray = (baseJustification: 'top' | 'center' | 'bottom') =>
+    `<m:eqArr><m:eqArrPr><m:baseJc m:val="${baseJustification}"/></m:eqArrPr>` +
+    `<m:e>${run('top')}</m:e><m:e>${run('bottom')}</m:e></m:eqArr>`;
+  const matrixAt = (baseJustification: 'top' | 'center' | 'bottom') => {
+    const node = find(layout(equationArray(baseJustification)).geometry, 'matrix');
+    if (node?.kind !== 'matrix') throw new Error('No equation array matrix');
+    return node;
+  };
+
+  const top = matrixAt('top');
+  const center = matrixAt('center');
+  const bottom = matrixAt('bottom');
+  expect(top.baseline).toBeLessThan(center.baseline);
+  expect(center.baseline).toBeLessThan(bottom.baseline);
+});
+
+test('draws the function application gap from a func structure', () => {
+  const content =
+    '<m:func><m:funcPr/><m:fName>' +
+    `<m:r><m:rPr><m:sty m:val="p"/></m:rPr><m:t>sin</m:t></m:r>` +
+    `</m:fName><m:e>${run('x')}</m:e></m:func>`;
+  const node = find(layout(content).geometry, 'row');
+  if (node?.kind !== 'row') throw new Error('No function row');
+  expect(node.items.flatMap((item) => (item.kind === 'text' ? [item.text] : []))).toEqual([
+    'sin',
+    '\u2009',
+    '\u{1d465}',
+  ]);
+});
