index 0000000..1f1206a
--- /dev/null
+++ b/packages/core/src/layout/equation-math-alphabet.ts
@@ -0,0 +1,86 @@
+// A derived display string. Source characters, offsets and serialized OMML never change.
+import type { MathScriptName } from '../store/package/omml-equation-expression.ts';
+
+type MathStyle = 'p' | 'b' | 'i' | 'bi';
+type Alphabet = { capital: number; small: number; digit?: number; holes?: ReadonlyMap<number, number> };
+
+const scriptHoles = new Map([
+  [0x42, 0x212c], [0x45, 0x2130], [0x46, 0x2131], [0x48, 0x210b],
+  [0x49, 0x2110], [0x4c, 0x2112], [0x4d, 0x2133], [0x52, 0x211b],
+  [0x65, 0x212f], [0x67, 0x210a], [0x6f, 0x2134],
+]);
+const frakturHoles = new Map([
+  [0x43, 0x212d], [0x48, 0x210c], [0x49, 0x2111], [0x52, 0x211c], [0x5a, 0x2128],
+]);
+const doubleStruckHoles = new Map([
+  [0x43, 0x2102], [0x48, 0x210d], [0x4e, 0x2115], [0x50, 0x2119],
+  [0x51, 0x211a], [0x52, 0x211d], [0x5a, 0x2124],
+]);
+
+function alphabetFor(script: Exclude<MathScriptName, 'roman'>, style: MathStyle): Alphabet | null {
+  const bold = style === 'b' || style === 'bi';
+  switch (script) {
+    case 'script':
+      return bold ? { capital: 0x1d4d0, small: 0x1d4ea }
+        : { capital: 0x1d49c, small: 0x1d4b6, holes: scriptHoles };
+    case 'fraktur':
+      return bold ? { capital: 0x1d56c, small: 0x1d586 }
+        : { capital: 0x1d504, small: 0x1d51e, holes: frakturHoles };
+    case 'double-struck':
+      return bold ? null : { capital: 0x1d538, small: 0x1d552, digit: 0x1d7d8, holes: doubleStruckHoles };
+    case 'monospace':
+      return bold ? null : { capital: 0x1d670, small: 0x1d68a, digit: 0x1d7f6 };
+    case 'sans-serif':
+      if (style === 'bi') return { capital: 0x1d63c, small: 0x1d656, digit: 0x1d7ec };
+      if (style === 'i') return { capital: 0x1d608, small: 0x1d622, digit: 0x1d7e2 };
+      return bold ? { capital: 0x1d5d4, small: 0x1d5ee, digit: 0x1d7ec }
+        : { capital: 0x1d5a0, small: 0x1d5ba, digit: 0x1d7e2 };
+  }
+}
+
+const greekSymbols = new Map([
+  [0x3f4, 17], [0x2207, 25], [0x2202, 51], [0x3f5, 52], [0x3d1, 53],
+  [0x3f0, 54], [0x3d5, 55], [0x3f1, 56], [0x3d6, 57],
+]);
+
+function greekGlyph(code: number, base: number): number | undefined {
+  if (code >= 0x391 && code <= 0x3a9 && code !== 0x3a2) return base + code - 0x391;
+  if (code >= 0x3b1 && code <= 0x3c9) return base + 26 + code - 0x3b1;
+  const symbol = greekSymbols.get(code);
+  return symbol === undefined ? undefined : base + symbol;
+}
+
+export interface MathScriptTextExpression {
+  readonly value: string;
+  readonly format?: { readonly mathScript?: MathScriptName; readonly mathStyle?: MathStyle };
+}
+
+/** Null means an alphabet combination has no faithful representation in this layout lane. */
+export function equationMathScriptText(expression: MathScriptTextExpression): {
+  readonly text: string | null;
+  readonly mathScript: MathScriptName | null;
+} {
+  const script = expression.format?.mathScript;
+  if (!script || script === 'roman') return { text: expression.value, mathScript: null };
+  const style = expression.format?.mathStyle ?? 'i';
+  const alphabet = alphabetFor(script, style);
+  if (!alphabet) return { text: null, mathScript: script };
+  const greek = script === 'sans-serif' && (style === 'b' || style === 'bi')
+    ? (style === 'b' ? 0x1d756 : 0x1d790) : undefined;
+  const text = Array.from(expression.value, (character) => {
+    const code = character.codePointAt(0)!;
+    const hole = alphabet.holes?.get(code);
+    if (hole !== undefined) return String.fromCodePoint(hole);
+    if (code >= 0x41 && code <= 0x5a) return String.fromCodePoint(alphabet.capital + code - 0x41);
+    if (code >= 0x61 && code <= 0x7a) return String.fromCodePoint(alphabet.small + code - 0x61);
+    if (alphabet.digit !== undefined && code >= 0x30 && code <= 0x39)
+      return String.fromCodePoint(alphabet.digit + code - 0x30);
+    if (greek !== undefined) {
+      const mapped = greekGlyph(code, greek);
+      if (mapped !== undefined) return String.fromCodePoint(mapped);
+    }
+    // Operators, combining marks and text without a mathematical alphabet keep their value.
+    return character === '-' ? '−' : character === '*' ? '∗' : character;
+  }).join('');
+  return { text, mathScript: script };
+}
