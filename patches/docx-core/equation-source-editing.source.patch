@@ -0,0 +1,224 @@
+// Text, metrics, and row geometry for the bounded equation layout.
+
+import type { EquationExpression } from '@docx-editor.dev/core/store';
+import type {
+  EquationGeometry,
+  EquationRowGeometry,
+  EquationTextGeometry,
+} from './equation-layout.ts';
+import { measureDisplayText, withFontFamily, type ResolvedRunStyle } from './run-style.ts';
+import type { TextMeasurer } from './semantic-records.ts';
+import { equationDisplayText } from './equation-display-text.ts';
+import { equationMathScriptText } from './equation-math-alphabet.ts';
+import { box, shifted } from './equation-scripts.ts';
+
+export interface EquationLayoutCache {
+  readonly textStyle: ResolvedRunStyle;
+  /** The size of the text around the equation: the structure size without `m:ctrlPr`. */
+  readonly surroundingSizePt: number;
+  /** The equation is a display equation, so its fractions keep the padded placement. */
+  readonly display: boolean;
+  /**
+   * The size of the first atom, and that atom. Scripts and fractions after it take their
+   * offsets from this size, not from their own (`laterStructureSizePt`).
+   */
+  leading?: { readonly sizePt: number; readonly first: EquationExpression };
+  readonly formats: WeakMap<
+    object,
+    Map<boolean, { readonly style: ResolvedRunStyle; readonly cache: EquationLayoutCache }>
+  >;
+  readonly styles: Map<number, ResolvedRunStyle>;
+  readonly metrics: Map<number, ReturnType<TextMeasurer['lineMetrics']>>;
+}
+
+// A reduced size rounds down to whole half points, the unit of authored run sizes.
+export function scaledSizePt(sizePt: number, scale: number): number {
+  return scale < 1 ? Math.max(0.5, Math.floor(sizePt * scale * 2 + 1e-9) / 2) : sizePt * scale;
+}
+
+export function scaledStyle(
+  style: ResolvedRunStyle,
+  scale: number,
+  cache: EquationLayoutCache
+): ResolvedRunStyle {
+  const cached = cache.styles.get(scale);
+  if (cached) return cached;
+  const resolved =
+    scale === 1
+      ? style
+      : Object.freeze({
+          ...style,
+          fontSizePt: scaledSizePt(style.fontSizePt, scale),
+          characterSpacingPt: style.characterSpacingPt * scale,
+        });
+  cache.styles.set(scale, resolved);
+  return resolved;
+}
+
+export function metricsAt(
+  measurer: TextMeasurer,
+  style: ResolvedRunStyle,
+  scale: number,
+  cache: EquationLayoutCache
+): ReturnType<TextMeasurer['lineMetrics']> {
+  const cached = cache.metrics.get(scale);
+  if (cached) return cached;
+  const metrics = measurer.lineMetrics(scaledStyle(style, scale, cache));
+  cache.metrics.set(scale, metrics);
+  return metrics;
+}
+
+export function textGeometry(
+  kind: 'text' | 'fallback',
+  text: string,
+  measurer: TextMeasurer,
+  style: ResolvedRunStyle,
+  scale: number,
+  cache: EquationLayoutCache
+): EquationTextGeometry {
+  const resolved = scaledStyle(style, scale, cache);
+  const metrics = metricsAt(measurer, style, scale, cache);
+  return Object.freeze({
+    kind,
+    text,
+    fontSizePt: resolved.fontSizePt,
+    runStyle: resolved,
+    box: box(0, 0, measureDisplayText(text, resolved, measurer), metrics.height),
+    baseline: metrics.baseline,
+  });
+}
+
+export function rowGeometry(
+  items: readonly EquationGeometry[],
+  fallbackMetrics: { readonly height: number; readonly baseline: number },
+  /** The space, in points, before each item. */
+  spaces?: readonly number[]
+): EquationRowGeometry {
+  if (items.length === 0) {
+    return Object.freeze({
+      kind: 'row',
+      items: Object.freeze([]),
+      box: box(0, 0, 0, fallbackMetrics.height),
+      baseline: fallbackMetrics.baseline,
+    });
+  }
+  const baseline = Math.max(...items.map((child) => child.baseline));
+  const descent = Math.max(...items.map((child) => child.box.height - child.baseline));
+  let x = 0;
+  const placed = items.map((child, index) => {
+    x += spaces?.[index] ?? 0;
+    const result = shifted(child, x, baseline - child.baseline);
+    x += child.box.width;
+    return result;
+  });
+  return Object.freeze({
+    kind: 'row',
+    items: Object.freeze(placed),
+    box: box(0, 0, x, baseline + descent),
+    baseline,
+  });
+}
+
+type TextExpression = Extract<EquationExpression, { readonly kind: 'text' }>;
+
+export function layoutText(
+  expression: TextExpression,
+  measurer: TextMeasurer,
+  style: ResolvedRunStyle,
+  scale: number,
+  cache: EquationLayoutCache,
+  // A part of a split run shares the faces derived for the whole run.
+  source: object = expression
+): EquationGeometry {
+  const authoredFamily = expression.format?.fontFamily;
+  const textFace = authoredFamily && authoredFamily.trim().toLowerCase() !== 'cambria math';
+  const digitParts =
+    textFace && !expression.format?.normalText && (expression.format?.mathStyle ?? 'i') === 'i'
+      ? expression.value.match(/(?:[0-9]\p{M}*)+|[^0-9]+/gu)
+      : null;
+  if (digitParts && digitParts.length > 1) {
+    const parts = digitParts.map((value) =>
+      layoutText({ ...expression, value }, measurer, style, scale, cache, source)
+    );
+    return rowGeometry(parts, metricsAt(measurer, style, scale, cache));
+  }
+  const scriptSource =
+    !expression.format?.normalText && expression.format?.mathScript && expression.format.mathScript !== 'roman'
+      ? equationMathScriptText(expression)
+      : null;
+  if (scriptSource?.text === null) {
+    return textGeometry('fallback', expression.value || '…', measurer, style, scale, cache);
+  }
+  const display = scriptSource
+    ? {
+        ...equationDisplayText(
+          { ...expression, value: scriptSource.text },
+          authoredFamily ?? style.fontFamily
+        ),
+        mathematicalGlyphs: true,
+      }
+    : equationDisplayText(expression, authoredFamily ?? style.fontFamily);
+  const familyStyle =
+    authoredFamily && !display.mathematicalGlyphs
+      ? withFontFamily(style, authoredFamily)
+      : expression.format?.normalText
+        ? cache.textStyle
+        : style;
+  const formatKey = expression.format ?? source;
+  const digits = Boolean(textFace && display.mathStyle && !display.mathematicalGlyphs);
+  let formats = cache.formats.get(formatKey);
+  let formatted = formats?.get(digits);
+  if (!formatted) {
+    const face = Object.freeze({
+      ...familyStyle,
+      fontSizePt: textSizePt(expression, familyStyle),
+      ...(expression.appearance?.kerningMinPt !== undefined
+        ? {
+            kerningMinPt: expression.appearance.kerningMinPt,
+            kerningEnabled: expression.appearance.kerningMinPt > 0,
+          }
+        : {}),
+      ...(expression.appearance?.ligatures ? { ligatures: expression.appearance.ligatures } : {}),
+      // Mathematical alphanumeric glyphs already carry their style in this
+      // regular face. Do not request a second italic or bold font program.
+      bold:
+        display.mathStyle === null
+          ? (expression.format?.bold ?? familyStyle.bold)
+          : !display.mathematicalGlyphs &&
+            (digits && expression.format?.bold !== undefined
+              ? expression.format.bold
+              : display.mathStyle === 'b' || display.mathStyle === 'bi'),
+      italic:
+        display.mathStyle === null || digits
+          ? (expression.format?.italic ??
+            (digits
+              ? display.mathStyle === 'i' || display.mathStyle === 'bi'
+              : expression.format?.normalText
+                ? false
+                : familyStyle.italic))
+          : !display.mathematicalGlyphs &&
+            (display.mathStyle === 'i' || display.mathStyle === 'bi'),
+    });
+    formatted = {
+      style: face,
+      cache: {
+        textStyle: cache.textStyle,
+        surroundingSizePt: cache.surroundingSizePt,
+        display: cache.display,
+        styles: new Map(),
+        metrics: new Map(),
+        formats: new WeakMap(),
+      },
+    };
+    if (!formats) {
+      formats = new Map();
+      cache.formats.set(formatKey, formats);
+    }
+    formats.set(digits, formatted);
+  }
+  return textGeometry('text', display.text, measurer, formatted.style, scale, formatted.cache);
+}
+
+export function textSizePt(expression: TextExpression, style: ResolvedRunStyle): number {
+  return expression.format?.fontSizePt ?? expression.fontSizePt ?? style.fontSizePt;
+}
diff --git a/packages/core/src/store/package/omml-equation-structured-projection.ts b/packages/core/src/store/package/omml-equation-structured-projection.ts
new file mode 100644
index 0000000..b85ff88
--- /dev/null
+++ b/packages/core/src/store/package/omml-equation-structured-projection.ts
@@ -0,0 +1,314 @@
+import type {
+  EquationColumnAlignment,
+  EquationControlSource,
+  EquationExpression,
+} from './omml-equation-expression.ts';
+import {
+  equationMathChild as namedChild,
+  equationMathChildren as namedChildren,
+} from './omml-run-format.ts';
+import { isSupportedExpressionNode, mathOnOff, mathVal } from './omml-structure-support.ts';
+import type { OoxmlGenericElementNode } from './ooxml-tree.ts';
+
+interface StructuredProjectionContext {
+  readonly paths: readonly string[];
+  projectContainer(node: OoxmlGenericElementNode, depth: number, path: string): EquationExpression;
+  controlSource(node: OoxmlGenericElementNode, propertyName: string): EquationControlSource;
+  appendText(value: string): string;
+}
+
+/** The operator of one n-ary structure, including OMML's default integral. */
+export function naryOperator(node: OoxmlGenericElementNode): string {
+  const property = namedChild(node, 'naryPr');
+  const character = property ? namedChild(property, 'chr') : null;
+  return character ? (mathVal(character) ?? '∫') : '∫';
+}
+
+/** One delimiter character after OMML defaults. */
+export function delimiterCharacter(
+  node: OoxmlGenericElementNode,
+  name: 'begChr' | 'endChr' | 'sepChr',
+  fallback: string
+): string {
+  const property = namedChild(node, 'dPr');
+  const character = property ? namedChild(property, name) : null;
+  return character ? (mathVal(character) ?? '') : fallback;
+}
+
+function matrixColumns(
+  node: OoxmlGenericElementNode,
+  cellCount: number
+): EquationColumnAlignment[] {
+  const property = namedChild(node, 'mPr');
+  const columnsProperty = property ? namedChild(property, 'mcs') : null;
+  const columns = columnsProperty
+    ? namedChildren(columnsProperty, 'mc').flatMap((column) => {
+        const properties = namedChild(column, 'mcPr');
+        const count = properties ? namedChild(properties, 'count') : null;
+        const alignment = properties ? namedChild(properties, 'mcJc') : null;
+        const repeat = count ? Number(mathVal(count)) : 1;
+        const value = mathVal(alignment ?? column);
+        const result: EquationColumnAlignment =
+          value === 'left' || value === 'right' ? value : 'center';
+        return Array.from({ length: repeat }, () => result);
+      })
+    : [];
+  while (columns.length < cellCount) columns.push('center');
+  return columns;
+}
+
+function matrixBaseJustification(
+  node: OoxmlGenericElementNode,
+  propertyName: 'mPr' | 'eqArrPr'
+): 'top' | 'center' | 'bottom' | undefined {
+  const property = namedChild(node, propertyName);
+  const baseJustification = property ? namedChild(property, 'baseJc') : null;
+  const value = baseJustification ? mathVal(baseJustification) : undefined;
+  return value === 'top' || value === 'center' || value === 'bottom' ? value : undefined;
+}
+
+function matrixHidePlaceholders(node: OoxmlGenericElementNode): true | undefined {
+  const property = namedChild(node, 'mPr');
+  return property && mathOnOff(namedChild(property, 'plcHide')) ? true : undefined;
+}
+
+function delimiterGrows(node: OoxmlGenericElementNode): boolean {
+  const property = namedChild(node, 'dPr');
+  const grow = property ? namedChild(property, 'grow') : null;
+  return grow ? mathOnOff(grow) : true;
+}
+
+/**
+ * Pandoc's OMML equation array carries TeX's `&` alignment marker as literal run text.
+ * Split only the projected row, leaving the original OMML untouched. Each marker starts the
+ * next cell, and the matrix layout right-aligns all but the final cell.
+ */
+function equationArrayCells(row: EquationExpression): EquationExpression[] {
+  const cells: EquationExpression[][] = [[]];
+  const visit = (item: EquationExpression): void => {
+    if (item.kind === 'row') {
+      item.items.forEach(visit);
+      return;
+    }
+    if (item.kind !== 'text') {
+      cells.at(-1)!.push(item);
+      return;
+    }
+    const parts = item.value.split('&');
+    parts.forEach((value, index) => {
+      if (value.length > 0) cells.at(-1)!.push(Object.freeze({ ...item, value }));
+      if (index + 1 < parts.length) cells.push([]);
+    });
+  };
+  visit(row);
+  return cells.map((items) =>
+    items.length === 1
+      ? items[0]!
+      : Object.freeze({ kind: 'row', items: Object.freeze(items), preserveSource: true as const })
+  );
+}
+
+/**
+ * Project one structure that owns layout semantics beyond run text. The caller supplies the
+ * projection state through callbacks, so this module changes neither source nor work limits.
+ */
+export function projectStructuredExpression(
+  node: OoxmlGenericElementNode,
+  depth: number,
+  context: StructuredProjectionContext
+): EquationExpression | null {
+  if (!isSupportedExpressionNode(node)) return null;
+  const containerPath = (name: string, occurrence = 0): string => {
+    const container = namedChildren(node, name)[occurrence]!;
+    return context.paths[node.children.indexOf(container)]!;
+  };
+  const control = (propertyName: string) => context.controlSource(node, propertyName);
+
+  if (node.localName === 'bar') {
+    const property = namedChild(node, 'barPr');
+    const position = property ? namedChild(property, 'pos') : null;
+    return Object.freeze({
+      kind: 'bar',
+      body: context.projectContainer(namedChildren(node, 'e')[0]!, depth + 1, containerPath('e')),
+      position: position && mathVal(position) === 'top' ? 'top' : 'bottom',
+      ...control('barPr'),
+    });
+  }
+  if (node.localName === 'borderBox') {
+    const property = namedChild(node, 'borderBoxPr');
+    const flag = (name: string) => (property ? mathOnOff(namedChild(property, name)) : false);
+    return Object.freeze({
+      kind: 'borderBox',
+      body: context.projectContainer(namedChildren(node, 'e')[0]!, depth + 1, containerPath('e')),
+      hidden: Object.freeze({
+        top: flag('hideTop'),
+        bottom: flag('hideBot'),
+        left: flag('hideLeft'),
+        right: flag('hideRight'),
+      }),
+      strikes: Object.freeze({
+        horizontal: flag('strikeH'),
+        vertical: flag('strikeV'),
+        bottomLeftToTopRight: flag('strikeBLTR'),
+        topLeftToBottomRight: flag('strikeTLBR'),
+      }),
+      ...control('borderBoxPr'),
+    });
+  }
+  if (node.localName === 'f') {
+    const numerator = namedChild(node, 'num');
+    const denominator = namedChild(node, 'den');
+    if (!numerator || !denominator) return null;
+    return Object.freeze({
+      kind: 'fraction',
+      numerator: context.projectContainer(numerator, depth + 1, containerPath('num')),
+      denominator: context.projectContainer(denominator, depth + 1, containerPath('den')),
+      ...control('fPr'),
+    });
+  }
+  if (node.localName === 'rad') {
+    const radicand = namedChild(node, 'e');
+    if (!radicand) return null;
+    const degree = namedChild(node, 'deg');
+    const projectedDegree =
+      degree && degree.children.length > 0
+        ? context.projectContainer(degree, depth + 1, containerPath('deg'))
+        : undefined;
+    return Object.freeze({
+      kind: 'radical',
+      radicand: context.projectContainer(radicand, depth + 1, containerPath('e')),
+      ...(projectedDegree === undefined ? {} : { degree: projectedDegree }),
+      ...control('radPr'),
+    });
+  }
+  if (node.localName === 'sSup' || node.localName === 'sSub' || node.localName === 'sSubSup') {
+    const base = namedChild(node, 'e');
+    const subscript = node.localName === 'sSup' ? null : namedChild(node, 'sub');
+    const superscript = node.localName === 'sSub' ? null : namedChild(node, 'sup');
+    if (
+      !base ||
+      (node.localName !== 'sSup' && !subscript) ||
+      (node.localName !== 'sSub' && !superscript)
+    ) {
+      return null;
+    }
+    return Object.freeze({
+      kind: 'script',
+      base: context.projectContainer(base, depth + 1, containerPath('e')),
+      ...(subscript
+        ? { subscript: context.projectContainer(subscript, depth + 1, containerPath('sub')) }
+        : {}),
+      ...(superscript
+        ? { superscript: context.projectContainer(superscript, depth + 1, containerPath('sup')) }
+        : {}),
+      ...control(`${node.localName}Pr`),
+    });
+  }
+  if (node.localName === 'nary') {
+    const body = namedChild(node, 'e');
+    if (!body) return null;
+    const lower = namedChild(node, 'sub');
+    const upper = namedChild(node, 'sup');
+    const property = namedChild(node, 'naryPr');
+    const limitLocation = property
+      ? mathVal(namedChild(property, 'limLoc') ?? property)
+      : undefined;
+    const lowerHidden = property ? mathOnOff(namedChild(property, 'subHide')) : false;
+    const upperHidden = property ? mathOnOff(namedChild(property, 'supHide')) : false;
+    return Object.freeze({
+      kind: 'nary',
+      operator: context.appendText(naryOperator(node)),
+      body: context.projectContainer(body, depth + 1, containerPath('e')),
+      ...(lower && lower.children.length > 0
+        ? { lowerLimit: context.projectContainer(lower, depth + 1, containerPath('sub')) }
+        : {}),
+      ...(upper && upper.children.length > 0
+        ? { upperLimit: context.projectContainer(upper, depth + 1, containerPath('sup')) }
+        : {}),
+      ...(limitLocation === 'undOvr' || limitLocation === 'subSup' ? { limitLocation } : {}),
+      ...(lowerHidden ? { hideLowerLimit: true as const } : {}),
+      ...(upperHidden ? { hideUpperLimit: true as const } : {}),
+      ...(lowerHidden || upperHidden ? { preserveSource: true as const } : {}),
+      ...control('naryPr'),
+    });
+  }
+  if (node.localName === 'eqArr') {
+    const rows = namedChildren(node, 'e').map((row, index) =>
+      equationArrayCells(context.projectContainer(row, depth + 1, containerPath('e', index)))
+    );
+    const columnCount = Math.max(0, ...rows.map((row) => row.length));
+    const columns: EquationColumnAlignment[] =
+      columnCount <= 1
+        ? Array.from({ length: columnCount }, () => 'center')
+        : Array.from({ length: columnCount }, (_, index) =>
+            index + 1 === columnCount ? 'left' : 'right'
+          );
+    const baseJustification = matrixBaseJustification(node, 'eqArrPr');
+    return Object.freeze({
+      kind: 'matrix',
+      rows: Object.freeze(rows.map((row) => Object.freeze({ cells: Object.freeze(row) }))),
+      columns: Object.freeze(columns),
+      ...(baseJustification === undefined ? {} : { baseJustification }),
+      preserveSource: true,
+      ...control('eqArrPr'),
+    });
+  }
+  if (node.localName === 'func') {
+    const name = namedChild(node, 'fName');
+    const body = namedChild(node, 'e');
+    if (!name || !body) return null;
+    const functionName = context.projectContainer(name, depth + 1, containerPath('fName'));
+    // OMML's function structure owns the application gap. Pandoc commonly emits plain runs,
+    // so the same bounded projection keeps a thin gap for either source spelling.
+    const gap = context.appendText('\u2009');
+    const functionBody = context.projectContainer(body, depth + 1, containerPath('e'));
+    return Object.freeze({
+      kind: 'row',
+      items: Object.freeze([
+        functionName,
+        Object.freeze({ kind: 'text', value: gap }),
+        functionBody,
+      ]),
+      preserveSource: true,
+      ...control('funcPr'),
+    });
+  }
+  if (node.localName === 'm') {
+    const rows = namedChildren(node, 'mr').map((row) => ({
+      cells: namedChildren(row, 'e').map((cell, cellIndex) =>
+        context.projectContainer(
+          cell,
+          depth + 2,
+          context.paths[node.children.indexOf(row)]! + `/m:e[${cellIndex + 1}]`
+        )
+      ),
+    }));
+    const cellCount = Math.max(0, ...rows.map((row) => row.cells.length));
+    const baseJustification = matrixBaseJustification(node, 'mPr');
+    return Object.freeze({
+      kind: 'matrix',
+      rows: Object.freeze(rows.map((row) => Object.freeze(row))),
+      columns: Object.freeze(matrixColumns(node, cellCount)),
+      ...(baseJustification === undefined ? {} : { baseJustification }),
+      ...(matrixHidePlaceholders(node) ? { hidePlaceholders: true as const } : {}),
+      preserveSource: true,
+      ...control('mPr'),
+    });
+  }
+  if (node.localName === 'd') {
+    const items = namedChildren(node, 'e').map((item, index) =>
+      context.projectContainer(item, depth + 1, containerPath('e', index))
+    );
+    return Object.freeze({
+      kind: 'delimiter',
+      begin: delimiterCharacter(node, 'begChr', '('),
+      end: delimiterCharacter(node, 'endChr', ')'),
+      separator: delimiterCharacter(node, 'sepChr', '|'),
+      items: Object.freeze(items),
+      grow: delimiterGrows(node),
+      preserveSource: true,
+      ...control('dPr'),
+    });
+  }
+  return null;
+}
diff --git a/packages/core/src/store/store/tree-op-math-equation.ts b/packages/core/src/store/store/tree-op-math-equation.ts
new file mode 100644
index 0000000..1d9e3c8
--- /dev/null
+++ b/packages/core/src/store/store/tree-op-math-equation.ts
@@ -0,0 +1,40 @@
+import { findNode } from '../package/ooxml-edit.ts';
+import { OFFICE_MATH_NAMESPACE_URI, parseLinearMath } from '../package/omml-equation.ts';
+import type { OoxmlPart } from '../package/ooxml-tree.ts';
+import { isMathEquationShape } from './equation-snippet.ts';
+import type { SetMathEquationOp, TreeOpRejection } from './tree-op-types.ts';
+import { nodeTouchesContentRestriction } from './tree-op-validate-controls.ts';
+
+type MathEquationOp =
+  | SetMathEquationOp
+  | {
+      readonly op: 'removeMathEquation';
+      readonly equationId: string;
+    };
+
+/** Validate replacement or removal of one complete `m:oMath` atom. */
+export function validateMathEquationOp(
+  part: OoxmlPart,
+  op: MathEquationOp
+): TreeOpRejection | null {
+  const equation = findNode(part, op.equationId);
+  if (!equation) return 'unknown-paragraph';
+  if (
+    equation.kind === 'textValue' ||
+    equation.kind !== 'generic' ||
+    equation.namespaceUri !== OFFICE_MATH_NAMESPACE_URI ||
+    equation.localName !== 'oMath'
+  ) {
+    return 'not-a-paragraph';
+  }
+  const restriction = nodeTouchesContentRestriction(part, op.equationId);
+  if (restriction) return restriction;
+  if (op.op === 'setMathEquation') {
+    const linear = op.linear !== undefined;
+    const structured = op.equation !== undefined;
+    if (linear === structured) return 'invalid-property-value';
+    if (structured && !isMathEquationShape(op.equation)) return 'invalid-property-value';
+    if (linear && !parseLinearMath(op.linear).ok) return 'invalid-property-value';
+  }
+  return null;
+}
