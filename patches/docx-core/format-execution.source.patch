--- /dev/null
+++ b/packages/core/src/store/__tests__/format-execution.test.ts
@@ -0,0 +1,67 @@
+import { expect, test } from 'bun:test';
+import { applyTreeOp } from '../store/tree-ops.ts';
+import { directParagraphProperties, mergedProperties } from '../store/direct-properties.ts';
+import { readOoxmlPart, serializeOoxmlPart } from '../package/ooxml-tree.ts';
+
+
+const W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
+function part() {
+  const parsed = readOoxmlPart(`<w:document xmlns:w="${W}"><w:body><w:p><w:pPr><w:keepNext/></w:pPr><w:r><w:t>Title</w:t></w:r></w:p><w:sectPr><w:cols w:num="3" w:space="500" w:sep="1"/></w:sectPr></w:body></w:document>`, { name: "/word/document.xml", contentType: "app/xml" });
+  if (!parsed.ok) throw new Error(parsed.reason);
+  return parsed.part;
+}
+
+test('frame authoring and removal preserve other paragraph properties', () => {
+  const original = part();
+  const paragraph = original.root.children.flatMap((node) => node.kind === 'textValue' ? [] : node.children).find((node) => node.kind === 'paragraph');
+  if (!paragraph) throw new Error('paragraph');
+  const properties = directParagraphProperties(original, paragraph.id);
+  const framed = applyTreeOp(original, { op: 'setParagraphProperties', paragraphId: paragraph.id, properties: mergedProperties(properties, { localName: 'framePr', attributes: { w: '10000', wrap: 'notBeside', hAnchor: 'page' } }) });
+  expect(framed.ok).toBe(true);
+  if (!framed.ok) throw new Error(framed.reason);
+  expect(serializeOoxmlPart(framed.part)).toContain('w:framePr');
+  const removed = applyTreeOp(framed.part, { op: 'setParagraphProperties', paragraphId: paragraph.id, properties });
+  if (!removed.ok) throw new Error(removed.reason);
+  expect(serializeOoxmlPart(removed.part)).not.toContain('w:framePr');
+  expect(serializeOoxmlPart(removed.part)).toContain('w:keepNext');
+});
+
+test('column count writes preserve omitted column settings and reject invalid counts', () => {
+  const original = part();
+  const result = applyTreeOp(original, { op: 'setSectionProperties', columns: { count: 2 } });
+  if (!result.ok) throw new Error(result.reason);
+  const xml = serializeOoxmlPart(result.part);
+  expect(xml).toContain('w:num="2"');
+  expect(xml).toContain('w:space="500"');
+  expect(xml).toContain('w:sep="1"');
+  expect(applyTreeOp(original, { op: 'setSectionProperties', columns: { count: 0 } }).ok).toBe(false);
+});
+
+
+test('saving equal-width column edits preserves absent or true equalWidth declarations', () => {
+  for (const declaration of ['', ' w:equalWidth="true"', ' w:equalWidth="1"']) {
+    const opened = readOoxmlPart(`<w:document xmlns:w="${W}"><w:body><w:p/><w:sectPr><w:cols w:num="1"${declaration}/></w:sectPr></w:body></w:document>`, { name: '/word/document.xml', contentType: 'app/xml' });
+    if (!opened.ok) throw new Error(opened.reason);
+    const result = applyTreeOp(opened.part, { op: 'setSectionProperties', columns: { count: 2, spaceTwips: 288, separator: false } });
+    if (!result.ok) throw new Error(result.reason);
+    const xml = serializeOoxmlPart(result.part);
+    expect(xml).toContain('w:num="2"');
+    expect(xml).toContain('w:space="288"');
+    expect(xml).toContain('w:sep="0"');
+    if (declaration) expect(xml).toContain(declaration.trim());
+    else expect(xml).not.toContain('equalWidth');
+  }
+});
+
+test('equal-width column requests convert unequal declarations and remove per-column widths', () => {
+  for (const declaration of [' w:equalWidth="0"', ' w:equalWidth="false"', '']) {
+    const opened = readOoxmlPart(`<w:document xmlns:w="${W}"><w:body><w:p/><w:sectPr><w:cols w:num="2"${declaration}><w:col w:w="2000" w:space="300"/><w:col w:w="4000"/></w:cols></w:sectPr></w:body></w:document>`, { name: '/word/document.xml', contentType: 'app/xml' });
+    if (!opened.ok) throw new Error(opened.reason);
+    const result = applyTreeOp(opened.part, { op: 'setSectionProperties', columns: { count: 3 } });
+    if (!result.ok) throw new Error(result.reason);
+    const xml = serializeOoxmlPart(result.part);
+    expect(xml).toContain('w:num="3"');
+    expect(xml).toContain('w:equalWidth="1"');
+    expect(xml).not.toContain('<w:col ');
+  }
+});
diff --git a/packages/core/src/automation/__tests__/format-execution.test.ts b/packages/core/src/automation/__tests__/format-execution.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/src/automation/__tests__/format-execution.test.ts
@@ -0,0 +1,20 @@
+import { expect, test } from 'bun:test';
+import { docx, open, p, paragraphsOf, roots, savedMainXml, refusal } from './support/protocol.ts';
+
+test('two disjoint font ranges in one paragraph share a transaction', () => {
+  const host = open(docx(p('Alpha Middle Omega')));
+  const [paragraph] = paragraphsOf(host, roots(host).body);
+  const response = host.execute({ operations: [
+    { op: 'setFont', span: { start: { paragraph: paragraph!, offset: 0 }, end: { paragraph: paragraph!, offset: 5 } }, font: { bold: true } },
+    { op: 'setFont', span: { start: { paragraph: paragraph!, offset: 13 }, end: { paragraph: paragraph!, offset: 18 } }, font: { italic: true } },
+  ] });
+  expect(response.ok).toBe(true);
+  expect(response.revision).toBe(1);
+  expect(savedMainXml(host)).toContain('Alpha');
+  const overlapping = host.execute({ operations: [
+    { op: 'setFont', span: { start: { paragraph: paragraph!, offset: 0 }, end: { paragraph: paragraph!, offset: 8 } }, font: { bold: true } },
+    { op: 'setFont', span: { start: { paragraph: paragraph!, offset: 5 }, end: { paragraph: paragraph!, offset: 12 } }, font: { italic: true } },
+  ] });
+  expect(refusal(overlapping)).toBe('conflicting-operations');
+  expect(overlapping.revision).toBe(1);
+});
