+import { expect, test } from 'bun:test';
+import { strFromU8, strToU8, unzipSync, zipSync } from 'fflate';
+import { docx } from '../../automation/__tests__/support/protocol.ts';
+import { readOoxmlPackage } from '../package/ooxml-package.ts';
+import { serializeOoxmlPart } from '../package/ooxml-tree.ts';
+import { literalizeThemeReferences } from '../store/clipboard-fragment-closure.ts';
+import { planImportStyles } from '../store/clipboard-fragment-merge.ts';
+
+function pkg(styles: string) {
+  const opened = readOoxmlPackage(docx('<w:p><w:r><w:t>Keep content</w:t></w:r></w:p>', styles));
+  if (!opened.ok) throw new Error(opened.reason);
+  return opened.package;
+}
+const base = '<w:style w:type="paragraph" w:styleId="Base"><w:name w:val="Base"/><w:rPr><w:b/></w:rPr></w:style>';
+const title = '<w:style w:type="paragraph" w:styleId="Title"><w:name w:val="Title"/><w:basedOn w:val="Base"/><w:link w:val="TitleChar"/><w:pPr><w:framePr w:w="10000"/></w:pPr></w:style>';
+const linked = '<w:style w:type="character" w:styleId="TitleChar"><w:name w:val="TitleChar"/><w:link w:val="Title"/><w:rPr><w:i/></w:rPr></w:style>';
+
+test('imports selected styles and linked dependency closure without changing content or collision definitions', () => {
+  const target = pkg('<w:style w:type="paragraph" w:styleId="Title"><w:name w:val="Title"/><w:rPr><w:color w:val="FF0000"/></w:rPr></w:style>');
+  const source = pkg(base + title + linked + '<w:style w:type="paragraph" w:styleId="Unused"><w:name w:val="Unused"/></w:style>');
+  const result = planImportStyles(target, source, ['Title']);
+  if (!result.ok) throw new Error(result.reason);
+  expect(result.styleIdMap.get('Title')).toBe('TitlePasted');
+  const styles = serializeOoxmlPart(result.pkg.parts.get('/word/styles.xml')!);
+  expect(styles).toContain('w:styleId="TitlePasted"');
+  expect(styles).toContain('w:val="TitlePasted"');
+  expect(styles).toContain('w:styleId="TitleChar"');
+  expect(styles).toContain('w:styleId="Base"');
+  expect(styles).not.toContain('w:styleId="Unused"');
+  expect(styles).toContain('w:val="FF0000"');
+  expect(serializeOoxmlPart(result.pkg.parts.get(target.mainDocumentPart)!)).toBe(serializeOoxmlPart(target.parts.get(target.mainDocumentPart)!));
+});
+
+test('reuses an identical definition and refuses missing dependencies', () => {
+  const source = pkg(base);
+  const result = planImportStyles(pkg(base), source, ['Base']);
+  if (!result.ok) throw new Error(result.reason);
+  expect(result.styleIdMap.get('Base')).toBe('Base');
+  expect(planImportStyles(pkg(''), source, ['Unknown']).ok).toBe(false);
+  expect(planImportStyles(pkg(''), pkg(title), ['Title']).ok).toBe(false);
+});
+
+test('a reused parent definition is remapped when its dependency collides', () => {
+  const target = pkg('<w:style w:type="paragraph" w:styleId="Base"><w:name w:val="Base"/><w:rPr><w:i/></w:rPr></w:style>' + title + linked);
+  const result = planImportStyles(target, pkg(title + linked + base), ['Title']);
+  if (!result.ok) throw new Error(result.reason);
+  expect(result.styleIdMap.get('Base')).toBe('BasePasted');
+  expect(result.styleIdMap.get('Title')).toBe('TitlePasted');
+  expect(result.styleIdMap.get('TitleChar')).toBe('TitleCharPasted');
+});
+
+
+test('theme literalization prioritizes resolved source faces and retains unresolved fallbacks', () => {
+  const source = pkg('<w:style w:type="paragraph" w:styleId="Theme"><w:name w:val="Theme"/><w:rPr><w:rFonts w:ascii="Stale" w:asciiTheme="majorHAnsi"/></w:rPr></w:style>');
+  const styles = source.parts.get('/word/styles.xml')!;
+  const resolved = literalizeThemeReferences(styles.root, { major: { latin: 'Resolved Source', eastAsia: null, cs: null }, minor: { latin: null, eastAsia: null, cs: null } });
+  const xml = serializeOoxmlPart({ ...styles, root: resolved as typeof styles.root });
+  expect(xml).toContain('w:ascii="Resolved Source"');
+  expect(xml).not.toContain('Stale');
+  expect(xml).not.toContain('asciiTheme');
+  const imported = planImportStyles(pkg(''), source, ['Theme']);
+  if (!imported.ok) throw new Error(imported.reason);
+  const unresolved = serializeOoxmlPart(imported.pkg.parts.get('/word/styles.xml')!);
+  expect(unresolved).toContain('w:ascii="Stale"');
+  expect(unresolved).not.toContain('asciiTheme');
+});
