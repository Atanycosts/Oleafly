diff --git a/packages/core/src/store/package/__tests__/original-entry-reuse.test.ts b/packages/core/src/store/package/__tests__/original-entry-reuse.test.ts
new file mode 100644
index 0000000..d0de9ae
--- /dev/null
+++ b/packages/core/src/store/package/__tests__/original-entry-reuse.test.ts
@@ -0,0 +1,258 @@
+// Saving reuses an XML part's original archive entry only when neither the tree nor its stored
+// bytes changed. These tests compare inflated entries, not ZIP containers: the writer pins its
+// own timestamps and may compress the same bytes differently without changing the part.
+
+import { describe, expect, test } from 'bun:test';
+import { strFromU8, strToU8, unzipSync, zipSync } from 'fflate';
+import { openTreeSession } from '../../../binding/tree-session.ts';
+import { normalizeParagraphIdentity } from '../para-id.ts';
+import { withoutPart } from '../package-edit.ts';
+import {
+  readOoxmlPackage,
+  withPart,
+  writeOoxmlPackage,
+  type OoxmlPackage,
+} from '../ooxml-package.ts';
+import { serializeOoxmlPart, type OoxmlPart } from '../ooxml-tree.ts';
+
+const W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
+const W14 = 'http://schemas.microsoft.com/office/word/2010/wordml';
+const CT = 'http://schemas.openxmlformats.org/package/2006/content-types';
+const REL = 'http://schemas.openxmlformats.org/package/2006/relationships';
+const R = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships';
+const OD = `${R}/officeDocument`;
+const COMMENTS_CT = 'application/vnd.openxmlformats-officedocument.wordprocessingml.comments+xml';
+const STYLES_CT = 'application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml';
+
+const CONTENT_TYPES =
+  `<Types xmlns="${CT}">` +
+  '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>' +
+  '<Default Extension="xml" ContentType="application/xml"/>' +
+  '<Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>' +
+  `<Override PartName="/word/styles.xml" ContentType="${STYLES_CT}"/>` +
+  `<Override PartName="/word/comments.xml" ContentType="${COMMENTS_CT}"/>` +
+  '</Types>';
+
+const ROOT_RELS =
+  `<Relationships xmlns="${REL}">` +
+  `<Relationship Id="rId1" Type="${OD}" Target="word/document.xml"/>` +
+  '</Relationships>';
+
+const DOCUMENT_RELS =
+  `<Relationships xmlns="${REL}">` +
+  `<Relationship Id="rId2" Type="${R}/comments" Target="comments.xml"/>` +
+  '</Relationships>';
+
+const STYLES =
+  `<?retain before-root?><!--styles XML comment--><w:styles xmlns:w="${W}">` +
+  "<w:style w:type='paragraph' w:styleId='Normal'><w:name w:val=\"Normal\"/></w:style>" +
+  '</w:styles>';
+
+const CUSTOM_XML =
+  '<?retain custom-data?><!--customXml XML comment-->' +
+  '<properties xmlns="urn:test:properties">' +
+  '<value><![CDATA[a & b]]></value></properties>';
+
+const COMMENTS =
+  `<?retain comments?><w:comments xmlns:w="${W}" xmlns:w14="${W14}">` +
+  '<w:comment w:id="1" w:author="Reviewer">' +
+  '<w:p w14:paraId="4C000002" w14:textId="4C000002"><w:r>' +
+  '<w:t><![CDATA[comment & text]]></w:t></w:r></w:p></w:comment></w:comments>';
+
+interface BuildOptions {
+  readonly validIdentity?: boolean;
+  readonly duplicateNoteProperties?: boolean;
+}
+
+function documentXml(options: BuildOptions = {}): string {
+  const paragraph = options.validIdentity
+    ? '<w:p w14:paraId="4C000001" w14:textId="4C000001">'
+    : '<w:p>';
+  const duplicateNoteProperties = options.duplicateNoteProperties
+    ? '<w:sectPr>' +
+      '<w:footnotePr><w:numFmt w:val="decimal"/></w:footnotePr>' +
+      '<w:footnotePr><w:numRestart w:val="eachSect"/></w:footnotePr>' +
+      '</w:sectPr>'
+    : '';
+  return (
+    `<w:document xmlns:w="${W}" xmlns:w14="${W14}"><!--main XML comment--><w:body>` +
+    paragraph +
+    '<w:r><w:t>hello</w:t></w:r></w:p>' +
+    duplicateNoteProperties +
+    '</w:body></w:document>'
+  );
+}
+
+function entries(options: BuildOptions = {}): Record<string, Uint8Array> {
+  return {
+    '[Content_Types].xml': strToU8(CONTENT_TYPES),
+    '_rels/.rels': strToU8(ROOT_RELS),
+    'word/document.xml': strToU8(documentXml(options)),
+    'word/_rels/document.xml.rels': strToU8(DOCUMENT_RELS),
+    'word/styles.xml': strToU8(STYLES),
+    'word/comments.xml': strToU8(COMMENTS),
+    'customXml/item1.xml': strToU8(CUSTOM_XML),
+  };
+}
+
+function docx(options: BuildOptions = {}): {
+  readonly bytes: Uint8Array;
+  readonly entries: Record<string, Uint8Array>;
+} {
+  const source = entries(options);
+  return { bytes: zipSync(source), entries: source };
+}
+
+function load(bytes: Uint8Array): OoxmlPackage {
+  const result = readOoxmlPackage(bytes);
+  if (!result.ok) throw new Error(`${result.reason}: ${result.detail ?? ''}`);
+  return result.package;
+}
+
+function open(bytes: Uint8Array) {
+  const result = openTreeSession(bytes);
+  if (!result.ok) throw new Error(`${result.reason}: ${result.detail ?? ''}`);
+  return result.session;
+}
+
+function canonicalBytes(part: OoxmlPart): Uint8Array {
+  return strToU8(serializeOoxmlPart(part));
+}
+
+function expectEntryBytes(
+  actual: Record<string, Uint8Array>,
+  expected: Record<string, Uint8Array>,
+  names: readonly string[]
+): void {
+  for (const name of names) expect(actual[name], name).toEqual(expected[name]);
+}
+
+function expectSameEntries(
+  actual: Record<string, Uint8Array>,
+  expected: Record<string, Uint8Array>
+): void {
+  expect(Object.keys(actual).sort()).toEqual(Object.keys(expected).sort());
+  expectEntryBytes(actual, expected, Object.keys(expected));
+}
+
+describe('original XML entry reuse', () => {
+  test('a no-op save reuses every untouched inflated entry byte-for-byte', () => {
+    const source = docx({ validIdentity: true });
+    const saved = unzipSync(open(source.bytes).save());
+    expectSameEntries(saved, source.entries);
+
+    const pkg = load(source.bytes);
+    for (const name of ['/word/styles.xml', '/word/comments.xml', '/customXml/item1.xml']) {
+      const part = pkg.parts.get(name);
+      expect(part, name).toBeDefined();
+      if (!part) continue;
+      expect(
+        canonicalBytes(part),
+        `${name} must exercise non-canonical source spelling`
+      ).not.toEqual(source.entries[name.slice(1)]);
+    }
+    for (const name of ['/word/document.xml', '/word/styles.xml', '/customXml/item1.xml']) {
+      const part = pkg.parts.get(name);
+      expect(part, name).toBeDefined();
+      if (!part) continue;
+      expect(strFromU8(canonicalBytes(part)), `${name} XML comment`).not.toContain(
+        '<!--'
+      );
+    }
+  });
+
+  test('a leaf edit canonicalizes only its changed part', () => {
+    const source = docx({ validIdentity: true });
+    const session = open(source.bytes);
+    const edited = session.applyTreeOps([
+      { op: 'insertText', paragraphId: session.paragraphIds()[0]!, offset: 0, text: 'X-' },
+    ]);
+    expect(edited.committed).toBe(true);
+
+    const saved = unzipSync(session.save());
+    expect(saved['word/document.xml']).not.toEqual(source.entries['word/document.xml']);
+    expect(strFromU8(saved['word/document.xml']!)).toContain('X-hello');
+    expectEntryBytes(saved, source.entries, [
+      '[Content_Types].xml',
+      '_rels/.rels',
+      'word/_rels/document.xml.rels',
+      'word/styles.xml',
+      'word/comments.xml',
+      'customXml/item1.xml',
+    ]);
+  });
+
+  test('undo restores the original entry when the loaded root becomes current again', () => {
+    const source = docx({ validIdentity: true });
+    const session = open(source.bytes);
+    const original = load(source.bytes);
+    const loadedMain = original.parts.get(original.mainDocumentPart)!;
+    expect(
+      session.applyTreeOps([
+        { op: 'insertText', paragraphId: session.paragraphIds()[0]!, offset: 0, text: 'X-' },
+      ]).committed
+    ).toBe(true);
+    // A package save follows an edit before the command that undoes it. This also avoids
+    // conflating the save writer's snapshot cache with the underlying history root.
+    expect(unzipSync(session.save())['word/document.xml']).not.toEqual(
+      source.entries['word/document.xml']
+    );
+    session.undo();
+    expect(session.part().root).toEqual(loadedMain.root);
+
+    expectSameEntries(unzipSync(session.save()), source.entries);
+  });
+
+  test('normalizing a part from the same load makes its entry serialize canonically', () => {
+    const source = docx();
+    const loaded = load(source.bytes);
+    const loadedMain = loaded.parts.get(loaded.mainDocumentPart)!;
+    const normalized = normalizeParagraphIdentity(loadedMain);
+    expect(normalized).not.toBe(loadedMain);
+
+    const saved = unzipSync(writeOoxmlPackage(withPart(loaded, normalized)));
+    expect(saved['word/document.xml']).not.toEqual(source.entries['word/document.xml']);
+    expect(strFromU8(saved['word/document.xml']!)).toContain('w14:paraId=');
+    expectEntryBytes(saved, source.entries, [
+      'word/styles.xml',
+      'word/comments.xml',
+      'customXml/item1.xml',
+    ]);
+  });
+
+  test('a save-time note-property repair invalidates reuse for the repaired part', () => {
+    const source = docx({ validIdentity: true, duplicateNoteProperties: true });
+    const session = open(source.bytes);
+    const saved = unzipSync(session.save());
+    const main = strFromU8(saved['word/document.xml']!);
+    expect(saved['word/document.xml']).not.toEqual(source.entries['word/document.xml']);
+    expect(main.match(/<w:footnotePr\b/g)).toHaveLength(1);
+    expectEntryBytes(saved, source.entries, ['word/styles.xml', 'customXml/item1.xml']);
+  });
+
+  test('replacing stored bytes or copying a part without its source record forces serialization', () => {
+    const source = docx({ validIdentity: true });
+    const pkg = load(source.bytes);
+    const styles = pkg.parts.get('/word/styles.xml')!;
+    const replacementBytes = new Map(pkg.partBytes);
+    replacementBytes.set('/word/styles.xml', strToU8(`${STYLES}\n`));
+
+    const replaced = unzipSync(writeOoxmlPackage({ ...pkg, partBytes: replacementBytes }));
+    expect([...replaced['word/styles.xml']!]).toEqual([...canonicalBytes(styles)]);
+
+    const copied = unzipSync(writeOoxmlPackage(withPart(pkg, { ...styles })));
+    expect([...copied['word/styles.xml']!]).toEqual([...canonicalBytes(styles)]);
+  });
+
+  test('deleting a part and its owner relationship cannot resurrect either record', () => {
+    const source = docx({ validIdentity: true });
+    const removed = withoutPart(load(source.bytes), '/word/comments.xml');
+    expect(removed.ok).toBe(true);
+
+    const saved = unzipSync(writeOoxmlPackage(removed.pkg));
+    expect(saved['word/comments.xml']).toBeUndefined();
+    expect(strFromU8(saved['word/_rels/document.xml.rels']!)).not.toContain('comments.xml');
+    expect(strFromU8(saved['[Content_Types].xml']!)).not.toContain('/word/comments.xml');
+    expectEntryBytes(saved, source.entries, ['word/styles.xml', 'customXml/item1.xml']);
+  });
+});
