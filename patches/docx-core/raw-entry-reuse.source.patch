@@ -51,7 +51,7 @@ import {
   type IgnoredContentTypes,
   type OverrideRecord,
 } from './content-types.ts';
-import type { OoxmlPart, OoxmlReadRejection } from './ooxml-tree.ts';
+import type { OoxmlElement, OoxmlPart, OoxmlReadRejection } from './ooxml-tree.ts';
 import { serializeOoxmlPartSteps } from './ooxml-serialize-steps.ts';
 import { captureXmlPartRoot } from './canonical-primitive-lower.ts';
 import { commentExportPackage } from './comment-export-cleanup.ts';
@@ -190,6 +190,19 @@ export interface OoxmlPackage {
   readonly mainDocumentPart: string;
 }
 
+interface OoxmlPartSource {
+  readonly root: OoxmlElement;
+  readonly bytes: Uint8Array;
+}
+
+/**
+ * Original entry bytes for one loaded tree.
+ *
+ * Keyed by the part object, so structural sharing keeps this record beside the unchanged part.
+ * A copied part without a recorded source falls back to canonical serialization.
+ */
+const ooxmlPartSources = new WeakMap<OoxmlPart, OoxmlPartSource>();
+
 /** Why a package could not be loaded. Every code describes the FILE, not the caller. */
 export type OoxmlPackageRejection =
   | ZipRejection
@@ -590,6 +603,7 @@ export function* readOoxmlPackageSteps(
       limits.xml
     );
     if (!read.ok) return { ok: false, reason: read.reason, detail: partName };
+    ooxmlPartSources.set(read.part, { root: read.part.root, bytes: data });
     parts.set(normalized.partName, read.part);
   }
 
@@ -675,6 +689,10 @@ export function* writeOoxmlPackageSteps(
   yield;
   const entries = new Map<string, Uint8Array>(exported.partBytes);
   for (const [name, part] of exported.parts) {
+    const source = ooxmlPartSources.get(part);
+    // The cleanup and repair passes above can replace a root or an entry. Reuse is sound only
+    // when both still match the exact objects read from the archive.
+    if (source?.root === part.root && exported.partBytes.get(name) === source.bytes) continue;
     entries.set(name, yield* serializeOoxmlPartSteps(part));
     yield;
   }
