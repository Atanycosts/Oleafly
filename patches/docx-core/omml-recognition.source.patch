index 0000000000000000000000000000000000000000..e02e3e9a9f1400002f1cd892a8a57b9f1436ac20
--- /dev/null
+++ b/packages/core/src/layout/__tests__/equation-matrix-delimiter.test.ts
@@ -0,0 +1,97 @@
+import { expect, test } from 'bun:test';
+import {
+  canonicalOoxmlFingerprint,
+  readOoxmlPart,
+  serializeOoxmlPart,
+} from '@docx-editor.dev/core/store';
+import { createFixedMeasurer, layoutSemanticDocument, linesOf } from '@docx-editor.dev/core/layout';
+import type { EquationGeometry } from '../equation-layout.ts';
+
+const W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
+const M = 'http://schemas.openxmlformats.org/officeDocument/2006/math';
+const run = (text: string) => `<m:r><m:t>${text}</m:t></m:r>`;
+const matrix =
+  '<m:m><m:mPr><m:mcs><m:mc><m:mcPr><m:count m:val="1"/>' +
+  '<m:mcJc m:val="left"/></m:mcPr></m:mc><m:mc><m:mcPr><m:count m:val="1"/>' +
+  '<m:mcJc m:val="right"/></m:mcPr></m:mc></m:mcs></m:mPr>' +
+  `<m:mr><m:e>${run('a')}</m:e><m:e>${run('long')}</m:e></m:mr>` +
+  `<m:mr><m:e>${run('wide')}</m:e><m:e>${run('b')}</m:e></m:mr></m:m>`;
+
+function layout(content: string) {
+  const opened = readOoxmlPart(
+    `<w:document xmlns:w="${W}" xmlns:m="${M}"><w:body>` +
+      `<w:p><w:r><w:t>A</w:t></w:r><m:oMath>${content}</m:oMath><w:r><w:t>Z</w:t></w:r></w:p>` +
+      '</w:body></w:document>',
+    { name: '/word/document.xml', contentType: 'application/xml' }
+  );
+  if (!opened.ok) throw new Error(opened.reason);
+  const before = canonicalOoxmlFingerprint(opened.part);
+  const result = layoutSemanticDocument(opened.part, 0, { measurer: createFixedMeasurer(6, 14) });
+  const span = linesOf(result)
+    .flatMap((line) => line.spans)
+    .find((span) => span.equation);
+  if (!span?.equation) throw new Error('No equation');
+  expect(span.range.end - span.range.start).toBe(1);
+  expect(canonicalOoxmlFingerprint(opened.part)).toBe(before);
+  return { geometry: span.equation.geometry, part: opened.part, before };
+}
+
+function find(
+  node: EquationGeometry,
+  kind: EquationGeometry['kind']
+): EquationGeometry | undefined {
+  if (node.kind === kind) return node;
+  const children =
+    node.kind === 'row' || node.kind === 'delimiter'
+      ? node.items
+      : node.kind === 'matrix'
+        ? node.rows.flat()
+        : [];
+  return children.map((child) => find(child, kind)).find(Boolean);
+}
+
+test('lays matrix rows and column alignment out without flattening cell boundaries', () => {
+  const { geometry } = layout(matrix);
+  const node = find(geometry, 'matrix');
+  if (node?.kind !== 'matrix') throw new Error('No matrix');
+  expect(node.rows.map((row) => row.length)).toEqual([2, 2]);
+  const [first, second] = node.rows;
+  expect(first![0]!.box.x).toBe(second![0]!.box.x);
+  expect(first![1]!.box.x + first![1]!.box.width).toBeCloseTo(
+    second![1]!.box.x + second![1]!.box.width,
+    6
+  );
+  expect(second![0]!.box.y).toBeGreaterThan(first![0]!.box.y + first![0]!.box.height);
+});
+
+test('stretches a one-sided delimiter to the matrix height and keeps its source unchanged', () => {
+  const { geometry, part, before } = layout(
+    '<m:d><m:dPr><m:begChr m:val="{"/>' + `<m:endChr m:val=""/></m:dPr><m:e>${matrix}</m:e></m:d>`
+  );
+  const node = find(geometry, 'delimiter');
+  if (node?.kind !== 'delimiter') throw new Error('No delimiter');
+  expect(node.items.map((item) => item.kind)).toEqual(['text', 'matrix']);
+  const sign = node.items[0]!;
+  if (sign.kind !== 'text') throw new Error('No delimiter sign');
+  expect(sign.text).toBe('{');
+  expect(sign.stretchY).toBeGreaterThan(1);
+  expect(sign.box.height).toBe(node.items[1]!.box.height);
+  const reopened = readOoxmlPart(serializeOoxmlPart(part), {
+    name: part.name,
+    contentType: part.contentType,
+  });
+  if (!reopened.ok) throw new Error(reopened.reason);
+  expect(canonicalOoxmlFingerprint(reopened.part)).toBe(before);
+});
+
+test('omits hidden n-ary limits from geometry without exposing their width or height', () => {
+  const content =
+    '<m:nary><m:naryPr><m:chr m:val="∑"/><m:supHide m:val="1"/>' +
+    `</m:naryPr><m:sub>${run('i')}</m:sub><m:sup>${run('verylongupperlimit')}</m:sup>` +
+    `<m:e>${run('x')}</m:e></m:nary>`;
+  const node = find(layout(content).geometry, 'nary');
+  if (node?.kind !== 'nary') throw new Error('No nary operator');
+  expect(node.upperLimit).toBeUndefined();
+  expect(node.lowerLimit).toBeDefined();
+  expect(node.box.width).toBeLessThan(100);
+});
