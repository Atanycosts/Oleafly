+/// Orders diagnostics across project restarts, which reuse [`ProjectInsId`]
+/// and begin again at revision 1.
+#[derive(Default)]
+pub(crate) struct DiagnosticRevisionGate {
+    projects: HashMap<ProjectInsId, DiagnosticProjectRevision>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct DiagnosticProjectRevision {
+    instance: ProjectInsInstanceId,
+    revision: usize,
+    active: bool,
+}
+
+impl DiagnosticRevisionGate {
+    pub(crate) fn accept(&mut self, version: &ProjVersion) -> bool {
+        if !self.observe(&version.id, version.instance) {
+            return false;
+        }
+
+        let project = self.projects.get_mut(&version.id).unwrap();
+        if version.revision < project.revision {
+            return false;
+        }
+
+        project.revision = version.revision;
+        true
+    }
+
+    fn observe(&mut self, id: &ProjectInsId, instance: ProjectInsInstanceId) -> bool {
+        let Some(project) = self.projects.get_mut(id) else {
+            self.projects.insert(
+                id.clone(),
+                DiagnosticProjectRevision {
+                    instance,
+                    revision: 0,
+                    active: true,
+                },
+            );
+            return true;
+        };
+
+        if instance < project.instance {
+            return false;
+        }
+        if instance > project.instance {
+            project.instance = instance;
+            project.revision = 0;
+            project.active = true;
+            return true;
+        }
+
+        project.active
+    }
+
+    pub(crate) fn remove(&mut self, id: &ProjectInsId, instance: ProjectInsInstanceId) -> bool {
+        let Some(project) = self.projects.get_mut(id) else {
+            self.projects.insert(
+                id.clone(),
+                DiagnosticProjectRevision {
+                    instance,
+                    revision: 0,
+                    active: false,
+                },
+            );
+            return true;
+        };
+
+        if instance < project.instance {
+            return false;
+        }
+        if instance > project.instance {
+            project.instance = instance;
+            project.revision = 0;
+        }
+
+        project.active = false;
+        true
+    }
+}
