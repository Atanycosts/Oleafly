+#[derive(Default)]
+pub(crate) struct StatusRevision {
+    instance: ProjectInsInstanceId,
+    revision: usize,
+    active: bool,
+}
+
+impl StatusRevision {
+    fn observe(&mut self, instance: ProjectInsInstanceId) -> bool {
+        if instance < self.instance {
+            return false;
+        }
+        if instance > self.instance {
+            self.instance = instance;
+            self.revision = 0;
+            self.active = true;
+            return true;
+        }
+        self.active
+    }
+
+    fn remove(&mut self, instance: ProjectInsInstanceId) -> bool {
+        if instance < self.instance {
+            return false;
+        }
+        if instance > self.instance {
+            self.instance = instance;
+            self.revision = 0;
+        }
+        self.active = false;
+        true
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct NotifiedRevision {
+    instance: ProjectInsInstanceId,
+    revision: usize,
+    signal: CompileSignal,
+    active: bool,
+}
+
+impl NotifiedRevision {
+    fn observe(&mut self, instance: ProjectInsInstanceId) -> bool {
+        if instance < self.instance {
+            return false;
+        }
+        if instance > self.instance {
+            self.instance = instance;
+            self.revision = 0;
+            self.signal = CompileSignal::default();
+            self.active = true;
+            return true;
+        }
+        self.active
+    }
+
+    fn remove(&mut self, instance: ProjectInsInstanceId) -> bool {
+        if instance < self.instance {
+            return false;
+        }
+        if instance > self.instance {
+            self.instance = instance;
+            self.revision = 0;
+            self.signal = CompileSignal::default();
+        }
+        self.active = false;
+        true
+    }
+}
