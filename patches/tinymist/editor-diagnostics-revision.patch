+    assert!(removed, "reload must retire the old primary instance");
+
+    harness
+        .server
+        .editor_tx
+        .send(EditorRequest::Diag(version, diagnostics))
+        .unwrap();
+
+    assert!(
+        !harness.drain_diagnostic_publications(|publication| {
+            publication.version.instance == retired_instance
+        }),
+        "late diagnostics from the replaced primary must be rejected"
+    );
 }
 
